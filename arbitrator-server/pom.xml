<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.arbitrator</groupId>
    <artifactId>arbitrator</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>arbitrator-server</artifactId>
  <name>Arbitrator :: Judge Server</name>

  <dependencies>
    <dependency>
      <groupId>com.arbitrator</groupId>
      <artifactId>arbitrator-common</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Parses and allowlist-cleans instructor-authored rich HTML before it
         reaches the admin browser or participant WebViews. -->
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
    </dependency>

    <!-- MySQL 8 (decision D1) -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <!-- JWT (NFR-S01/S07) -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!--
      application-local.yml is git-ignored (rules.md Rule 6) precisely so a
      developer's machine-specific overrides and real credentials never enter
      version control — but .gitignore has no effect on Maven, which just
      walks src/main/resources on disk regardless of what git tracks. Left
      unexcluded, whichever developer's machine happened to run the build
      that produced a shipped jar had THEIR local overrides baked directly
      into BOOT-INF/classes, active on every machine that jar is deployed to
      (spring.profiles.include: local loads it unconditionally). This is
      exactly how a Mac-only docker-binary path and a testing-only 0s
      submit-cooldown ended up hardcoded into every lab deployment package,
      regardless of what application.yml's real defaults said. Excluded here
      so a packaged jar can never contain it, no matter who builds it.
    -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>application-local.yml</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
