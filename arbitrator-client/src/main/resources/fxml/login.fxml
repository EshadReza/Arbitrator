<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<!-- UIF-01..04. All strings from the resource bundle (I18N-02). -->

<VBox alignment="TOP_CENTER" styleClass="login-root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arbitrator.client.controller.LoginController">
    <!-- Top toolbar for theme toggle button -->
    <HBox alignment="CENTER_RIGHT" maxWidth="Infinity">
        <padding><Insets top="12" right="16" bottom="0" left="16" /></padding>
        <Button fx:id="themeButton" onAction="#onToggleTheme" styleClass="icon-button" text="🌙" />
    </HBox>

    <!-- Main login container centered according to window size -->
    <VBox alignment="CENTER" spacing="12" VBox.vgrow="ALWAYS">
        <Label styleClass="logo" text="%app.title" />
        <Label styleClass="subtitle" text="%login.subtitle" />

        <VBox alignment="CENTER" prefWidth="440" maxWidth="440" spacing="12" styleClass="box, login-box">
            <padding><Insets top="28" right="32" bottom="28" left="32" /></padding>

            <HBox alignment="CENTER" spacing="6">
                <Circle fx:id="statusDot" radius="5" />
                <Label styleClass="subtitle" text="Server:" />
                <TextField fx:id="serverAddressField" promptText="127.0.0.1:8080" styleClass="login-input" style="-fx-font-size: 11px; -fx-padding: 3 6;" maxWidth="180" />
            </HBox>

            <TextField fx:id="usernameField" promptText="%login.username" styleClass="login-input" />
            <!-- UIF-02: Enter in the password field logs in -->
            <PasswordField fx:id="passwordField" onAction="#onLogin" promptText="%login.password" styleClass="login-input" />
            <Label fx:id="errorLabel" styleClass="error" wrapText="true" />
            <Button fx:id="loginButton" defaultButton="true" maxWidth="Infinity" onAction="#onLogin" text="%login.button" styleClass="login-button" />
            <Hyperlink onAction="#onGoToRegister" text="%login.register" />
        </VBox>
    </VBox>
</VBox>
