<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<!-- FR-16 / UIF-12: personal submission history.
     The source and the judgement protocol used to sit in a permanently docked
     pane under this table, costing half the tab whether or not anyone was
     reading them. They now open from a per-row button into a dialog, so the
     history itself gets the whole tab. Columns are built in code (RichTextFX
     controls are not FXML-friendly). -->
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.arbitrator.client.controller.SubmissionsPanelController"
      styleClass="box">

    <Label text="%submissions.title" styleClass="box-head" maxWidth="Infinity"/>
    <TableView fx:id="table" VBox.vgrow="ALWAYS"/>
    <Label fx:id="countLabel" styleClass="subtitle">
        <padding><Insets top="5" right="10" bottom="5" left="10"/></padding>
    </Label>
</VBox>
