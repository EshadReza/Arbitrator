<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<!-- FR-16 / UIF-12: personal submission history. Columns and the read-only
     CodeArea are built in code (RichTextFX controls are not FXML-friendly). -->
<SplitPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.arbitrator.client.controller.SubmissionsPanelController"
           dividerPositions="0.55" orientation="VERTICAL">

    <VBox styleClass="box">
        <Label text="%submissions.title" styleClass="box-head" maxWidth="Infinity"/>
        <TableView fx:id="table" VBox.vgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="subtitle">
            <padding><Insets top="5" right="10" bottom="5" left="10"/></padding>
        </Label>
    </VBox>

    <VBox fx:id="sourceBox" styleClass="box">
        <Label text="%submissions.detail" styleClass="box-head" maxWidth="Infinity"/>
        <Label fx:id="headerLabel" styleClass="subtitle">
            <padding><Insets top="6" right="10" bottom="6" left="10"/></padding>
        </Label>
        <!-- read-only CodeArea inserted here at runtime -->
    </VBox>
</SplitPane>
