<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Right panel (§4.2). The CodeArea is inserted programmatically at index 0
     by EditorController (RichTextFX controls are not FXML-friendly). -->
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.arbitrator.client.controller.EditorController"
      fx:id="editorBox" spacing="0" styleClass="box">

    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="editor-toolbar">
        <padding><Insets top="6" right="8" bottom="6" left="8"/></padding>
        <Label text="%editor.language"/>
        <ComboBox fx:id="languageBox" prefWidth="140"/>
        <Button fx:id="uploadButton" text="%editor.upload" onAction="#onUploadFile"
                styleClass="button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="submitButton" text="%editor.submit" onAction="#onSubmit"
                styleClass="submit-button"/>
        <Button fx:id="fullscreenButton" text="⛶" onAction="#onToggleFullscreen"
                styleClass="icon-button"/>
    </HBox>

    <!-- CodeArea is inserted here at runtime (index 1: below the toolbar,
         above the status bar) — see EditorController.initialize -->

    <!-- Custom input / output: run without submitting -->
    <TitledPane fx:id="customPane" text="%editor.custom" expanded="false" animated="false">
        <VBox spacing="6">
            <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="runButton" text="%editor.run" onAction="#onRunCustom"/>
                <Label fx:id="runStatus" styleClass="subtitle"/>
            </HBox>
            <Label text="%editor.customInput" styleClass="subtitle"/>
            <TextArea fx:id="customInput" prefRowCount="3" styleClass="compiler-log"/>
            <Label text="%editor.customOutput" styleClass="subtitle"/>
            <TextArea fx:id="customOutput" prefRowCount="4" editable="false"
                      styleClass="compiler-log"/>
        </VBox>
    </TitledPane>

    <HBox alignment="CENTER_RIGHT" styleClass="editor-statusbar">
        <padding><Insets top="3" right="8" bottom="3" left="8"/></padding>
        <Label fx:id="countLabel" styleClass="subtitle"/>
    </HBox>
</VBox>
