<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- FR-01 registration. Same split-card frame as login.fxml / contest-picker.fxml
     (see arbitrator.css's "login screen" section) but no hero panel — like the
     picker, this is a short form, not a branding moment, so a decorative side
     pane would be dead space instead of content. -->
<StackPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.arbitrator.client.controller.RegisterController"
           styleClass="login-page">
    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

    <HBox styleClass="login-frame">
        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

        <VBox styleClass="login-card" alignment="CENTER" HBox.hgrow="ALWAYS">
            <padding><Insets top="24" right="36" bottom="24" left="36"/></padding>

            <HBox alignment="CENTER_LEFT">
                <ImageView fitWidth="48" fitHeight="48" preserveRatio="true" smooth="true">
                    <Image url="@../images/app-logo.png"/>
                </ImageView>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- Not focus-traversable: as the first control in the scene it
                     would otherwise hold initial keyboard focus, stealing the
                     Enter key from the form's own defaultButton. -->
                <Button fx:id="themeButton" onAction="#onToggleTheme" styleClass="icon-button"
                        text="☾" focusTraversable="false"/>
            </HBox>

            <VBox alignment="CENTER" spacing="14" maxWidth="380" VBox.vgrow="ALWAYS">
                <Label text="%register.subtitle" styleClass="login-headline" wrapText="true"
                       maxWidth="Infinity" alignment="CENTER" textAlignment="CENTER"
                       style="-fx-font-size: 32px;"/>

                <TextField fx:id="usernameField" promptText="%register.username"
                           styleClass="login-pill-field" maxWidth="Infinity"/>
                <TextField fx:id="displayNameField" promptText="%register.displayName"
                           styleClass="login-pill-field" maxWidth="Infinity"/>
                <PasswordField fx:id="passwordField" promptText="%register.password"
                               styleClass="login-pill-field" maxWidth="Infinity"/>
                <!-- Enter in the last field submits, matching the login screen (UIF-02) -->
                <PasswordField fx:id="confirmField" promptText="%register.confirm"
                               styleClass="login-pill-field" maxWidth="Infinity" onAction="#onRegister"/>

                <Label fx:id="errorLabel" styleClass="error" wrapText="true"/>

                <Button fx:id="registerButton" text="%register.button" onAction="#onRegister"
                        defaultButton="true" maxWidth="Infinity" styleClass="login-signin-button"/>

                <HBox spacing="6" alignment="CENTER">
                    <Hyperlink text="%register.backToLogin" onAction="#onBackToLogin" styleClass="login-signup-link"/>
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</StackPane>
