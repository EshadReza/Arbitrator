<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<!-- Standings (UIF-13..16). Columns per problem are added at runtime by
     LeaderboardPanelController, since the count varies per contest. -->
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.labjudge.client.controller.LeaderboardPanelController"
      spacing="0" styleClass="box">

    <Label text="%leaderboard.title" styleClass="box-head" maxWidth="Infinity"/>

    <!-- UIF-16: amber, only visible while frozen -->
    <Label fx:id="freezeBanner" text="%leaderboard.frozen"
           styleClass="freeze-banner" maxWidth="Infinity"/>

    <TableView fx:id="table" VBox.vgrow="ALWAYS"/>

    <!-- UIF-14 -->
    <Label fx:id="updatedLabel" styleClass="subtitle">
        <padding><Insets top="4" right="8" bottom="4" left="8"/></padding>
    </Label>
</VBox>
